# ==============================================================================
# File di build e artefatti di compilazione C
# ==============================================================================
# Directory degli oggetti e dei binari compilati dal Makefile
obj/
bin/

# File oggetto, librerie e debug symbols
*.o
*.obj
*.a
*.so
*.dylib
*.dSYM/

# File di dump per crash e debug
core
core.*
vgcore.*

# ==============================================================================
# Output di simulazione e file generati a runtime
# ==============================================================================
statistiche.csv

# ==============================================================================
# IDE JetBrains (CLion / IntelliJ IDEA) - per il tuo compagno
# ==============================================================================
.idea/
cmake-build-*/
*.iws
*.iml
*.ipr
out/

# ==============================================================================
# Visual Studio Code
# ==============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ==============================================================================
# File di sistema operativo e temporanei
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux / Editor temporanei (Vim, Nano, Emacs)
*~
*.swp
*.swo
.#*
\#*\#

# Archivi di consegna temporanei (es. per non tracciare tar/zip creati per test)
*.tar.gz
*.tgz
*.zip